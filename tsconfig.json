{
    "compilerOptions": {
        "target" : "ES2022",
        "module": "NodeNext",
        "moduleResolution" : "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess":true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipDefaultLibCheck": true,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src"]
}